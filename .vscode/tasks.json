{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "clear-log-files",
            "type": "shell",
            "isBackground": false,
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "windows": {
                // Need to change if the Git Bash executale app in different location
                "command": "C:/Program Files/Git/bin/bash.exe",
                "args": ["${workspaceFolder}/.vscode/tasks/clear_log_files.sh"],
            },
            "linux": {
                "command": "bash",
                "args": ["${workspaceFolder}/.vscode/tasks/clear_log_files.sh"]
            },
            "osx": {
                "command": "bash",
                "args": ["${workspaceFolder}/.vscode/tasks/clear_log_files.sh"]
            }
        },
        {
            "label": "start-singularity-debug",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/output/issues/225/run_in_container.sh",
                "sample_3"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Starting Singularity",
                    "endsPattern": "^$"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "stop-singularity-debug",
            "type": "shell",
            "command": "pkill",
            "args": ["-f", "singularity exec.*run_in_container"],
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": []
        }
    ]
}
