{
    "configurations": [
        {
            "name": "Unit tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "discover",
                "-s", "scripts/tests",
                "-p", "test*.py",
                // "-p", "test_genbank.py",  // run a specific test
                "-b",
            ],
            "env": {
                "GENBANK_CONCURRENCY_TEST": "0",  // High network traffic
                "PYTHONPATH": "${workspaceFolder}/scripts",
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Integration tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "discover",
                "-s", "scripts/tests/integration",
                "-p", "test_integration.py",
                "-f",  // fail fast
                "-v",  // show stdout instead of dots
            ],
            "env": {
                "KEEP_OUTPUTS": "1",  // Always retain outputs for debugging
                "RUN_TEST_CASE": "A",  // Optional, run a specific test case
                "PYTHONPATH": "${workspaceFolder}/scripts",
                "TAXONKIT_DATA": "${env:HOME}/.taxonkit",
                // Note: PHYLOGENY_MAX_HITS_PER_SPECIES and GBIF_MAX_OCCURRENCE_RECORDS
                // are now passed as CLI arguments in the Python scripts
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "BOLD Integration tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "discover",
                "-s", "scripts/tests/integration",
                "-p", "test_integration_bold.py",
                "-f",  // fail fast
                "-v",  // show stdout instead of dots
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/scripts",
                "KEEP_OUTPUTS": "1",  // Always retain outputs for debugging
                "RUN_TEST_CASE": "112",  // Optional, run a specific test case
                // Note: GBIF_MAX_OCCURRENCE_RECORDS is now passed as CLI argument
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "P1 BLAST Parser",
            "program": "${workspaceFolder}/scripts/p1_parse_blast.py",
            "cwd": "${workspaceFolder}/scripts",
            "args": [
                "tests/test-data/output.xml",
                "--metadata-csv", "tests/test-data/metadata.csv",
                "--query-fasta", "tests/test-data/queries.fasta",
            ],
            "preLaunchTask": "clear-log-files"
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "P1 BOLD search",
            "program": "${workspaceFolder}/scripts/p1_bold_search.py",
            "cwd": "${workspaceFolder}/scripts",
            "args": [
                // "--output-dir", "output/bold",
                // "--metadata-csv", "tests/test-data/metadata.csv",
                // "--query-fasta", "tests/test-data/queries.fasta",
                // "--metadata-csv", "tests/test-data/metadata.csv",
                // "--query-fasta", "tests/test-data/queries.fasta",

                "--query-fasta", "output/issues/131/query.fasta",
                "--output-dir", "output/issues/131/bold",
                "--bold-database", "COX1_SPECIES_PUBLIC",
            ],
            "preLaunchTask": "clear-log-files",
            "env": {
                "LOGGING_DEBUG": "1",
                "SKIP_ORIENTATION": "1",
                "INPUT_METADATA_CSV_FILEPATH": "output/issues/131/metadata.csv",
                "INPUT_FASTA_FILEPATH": "output/issues/131/query.fasta",
            }
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "P2 Extract taxonomy",
            "program": "${workspaceFolder}/scripts/p2_extract_taxonomy.py",
            "cwd": "${workspaceFolder}/scripts",
            "args": [
                "output/taxids.csv",
                "--output-dir", "output",
            ],
            "preLaunchTask": "clear-log-files"
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "P3 Assign taxonomy",
            "program": "${workspaceFolder}/scripts/p3_assign_taxonomy.py",
            "cwd": "${workspaceFolder}/scripts",
            "args": [
                "output/query_001_LC438549.1",
                "--metadata-csv", "tests/test-data/metadata.csv",
                "--query-fasta", "tests/test-data/queries.fasta",

                // For testing phylogeny hit sampling:
                // "output/issues/c14/query_001_VE24-1067_COI",
                // "--output-dir", "output/issues/c14",
                // "--metadata-csv", "output/issues/c14/metadata_014.csv",
                // "--query-fasta", "output/issues/c14/query_014.fasta",

                "--phylogeny-max-per-species", "10",
                // "--max-candidates-analysis", "0",  // Force boxplot
            ],
            "env": {
                // Keep remaining env vars that aren't converted yet
            },
            "preLaunchTask": "clear-log-files"
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "P3 BOLD Assign taxonomy",
            "program": "${workspaceFolder}/scripts/p3_assign_taxonomy.py",
            "cwd": "${workspaceFolder}/scripts",
            "args": [
                // "output/bold/query_001_LC438549.1",
                // "output/bold/query_002_ON075825.1",
                // "output/bold/query_003_PP466915.1",
                // "output/bold/query_004_JQ585746.1",
                // "output/bold/query_005_LC547004.1",
                // "output/bold/query_006_VE24-1086_COI",
                // "--metadata-csv", "tests/test-data/metadata.csv",
                // "--query-fasta", "tests/test-data/queries.fasta",

                // For testing issue cases:
                "output/issues/108/query_001_VE24-1066_COI",
                "--output-dir", "output/issues/108",
                "--metadata-csv", "output/issues/108/metadata.csv",
                "--query-fasta", "output/issues/108/query.fasta",

                // "--max-candidates-analysis", "0",  // Force boxplot
                "--bold",
            ],
            "env": {
                // Keep remaining env vars that aren't converted yet
            },
            "preLaunchTask": "clear-log-files"
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "P4 Source diversity",
            "program": "${workspaceFolder}/scripts/p4_source_diversity.py",
            "cwd": "${workspaceFolder}/scripts",
            "args": [
                "output/query_001_LC438549.1",
                // "output/query_002_ON075825.1",
                // "output/query_003_PP466915.1"
                // "output/query_006_VE24-1086_COI"
                "--metadata-csv", "tests/test-data/metadata.csv",
                "--query-fasta", "tests/test-data/queries.fasta",
            ],
            "preLaunchTask": "clear-log-files"
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "P4 BOLD Source diversity",
            "program": "${workspaceFolder}/scripts/p4_source_diversity.py",
            "cwd": "${workspaceFolder}/scripts",
            "args": [
                // "output/bold/query_001_LC438549.1",
                // "--output-dir", "output/bold",
                // "--metadata-csv", "tests/test-data/metadata.csv",
                // "--query-fasta", "tests/test-data/queries.fasta",

                "output/issues/112/query_004_MG240613_4",
                "--output-dir", "output/issues/112",
                "--min-source-count", "5",
                "--metadata-csv", "output/issues/112/metadata.csv",
                "--query-fasta", "output/issues/112/query.fasta",
            ],
            "env": {
                "LOGGING_DEBUG": "1",
            },
            "preLaunchTask": "clear-log-files"
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "P5 DB coverage",
            "program": "${workspaceFolder}/scripts/p5_db_coverage.py",
            "cwd": "${workspaceFolder}/scripts",
            "args": [
                "output/query_001_LC438549.1",
                // "output/query_002_ON075825",
                // "output/query_003_PP466915"
                // "output/query_006_VE24-1086_COI"
                "--metadata-csv", "tests/test-data/metadata.csv",
                "--query-fasta", "tests/test-data/queries.fasta",

                "--db-coverage-toi-limit", "10",
                "--db-coverage-max-candidates", "3",
                "--gbif-limit-records", "500",
                "--gbif-max-occurrence-records", "5000",
                "--gbif-accepted-status", "accepted,doubtful",
                "--db-cov-target-min-a", "5",
                "--db-cov-target-min-b", "1",
                "--db-cov-related-min-a", "90",
                "--db-cov-related-min-b", "10",
                "--db-cov-country-missing-a", "1",

                // For testing issue cases:
                // "output/issues/31/query_001_VE24-1351_COI",
                // "--output-dir", "output/issues/31",
                // "--metadata-csv", "output/issues/31/metadata.csv",
                // "--query-fasta", "output/issues/31/queries.fasta",

                // "--gbif-max-occurrence-records", "200",
            ],
            "env": {
                "LOGGING_DEBUG": "1",
            },
            "preLaunchTask": "clear-log-files"
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "P5 BOLD DB coverage",
            "program": "${workspaceFolder}/scripts/p5_db_coverage.py",
            "cwd": "${workspaceFolder}/scripts",
            "args": [
                // "output/bold/query_001_LC438549.1",
                // "--output-dir", "output/bold",
                // "--metadata-csv", "tests/test-data/metadata.csv",
                // "--query-fasta", "tests/test-data/queries.fasta",

                // For testing issue cases:
                "output/issues/112/old_work/query_004_MG240613_4",
                "--output-dir", "output/issues/112/old_work",
                "--metadata-csv", "output/issues/112/metadata.csv",
                "--query-fasta", "output/issues/112/queries.fasta",

                "--bold",
                "--gbif-max-occurrence-records", "200",
            ],
            "env": {
                "LOGGING_DEBUG": "1",
            },
            "preLaunchTask": "clear-log-files"
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "P6 Workflow report",
            "program": "${workspaceFolder}/scripts/p6_report.py",
            "cwd": "${workspaceFolder}/scripts",
            "args": [
                "output/query_001_LC438549.1",
                // "output/query_002_ON075825.1",
                // "output/query_003_PP466915.1",
                // "output/query_005_LC547004",
                "--metadata-csv", "tests/test-data/metadata.csv",
                "--query-fasta", "tests/test-data/queries.fasta",

                "--versions_yml", "tests/test-data/versions.yml",
                "--params_json", "tests/test-data/params.json",
                "--facility-name", "Cairns Airport",
                "--analyst-name", "John Doe",
                "--report-debug",

                // For testing issue cases:
                // "output/issues/44/query_001_VE25-1406_COI",
                // "--output-dir", "output/issues/44",
                // "--query-fasta", "output/issues/44/query.fasta",
                // "--metadata-csv", "output/issues/44/metadata.csv",
            ],
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "P6 BOLD Workflow report",
            "program": "${workspaceFolder}/scripts/p6_report.py",
            "cwd": "${workspaceFolder}/scripts",
            "args": [
                // "output/bold/query_001_LC438549.1",
                // "--output-dir", "output/bold",
                // "--metadata-csv", "tests/test-data/metadata.csv",
                // "--query-fasta", "tests/test-data/queries.fasta",

                "output/issues/112/old_work/query_004_MG240613_4",
                "--output-dir", "output/issues/112/old_work",
                "--metadata-csv", "output/issues/112/metadata.csv",
                "--query-fasta", "output/issues/112/queries.fasta",

                "--bold",
                "--versions_yml", "tests/test-data/versions.yml",
                "--params_json", "tests/test-data/params.json",
            ],
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Render docs",
            "program": "${workspaceFolder}/scripts/dev/render_docs.py",
        },
        {
            "name": "FastAPI server (uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app:app",
                "--reload",
                "--port",
                "8002"
            ],
            "cwd": "${workspaceFolder}/cloudgene/downloader",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Generate config default.yml",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev/generate_default_config.py",
            "cwd": "${workspaceFolder}/scripts",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
