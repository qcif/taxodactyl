# Azure Environment Configuration
# Copy this file to .env.azure and fill in your actual values

# General Azure Configuration
SUBSCRIPTION="Your Azure Subscription Name"
REGION=australiaeast
RESOURCE_GROUP=your-resource-group
STORAGE_ACCOUNT_PREM=yourpremiumstorage
STORAGE_ACCOUNT_STD=yourstandardstorage
STORAGE_CONTAINER_REF=refdata
STORAGE_CONTAINER_WORK=workdata
STORAGE_CONTAINER_SCRIPTS=scripts
BATCH_ACCOUNT=yourbatchaccount
ACCOUNT_ENDPOINT=yourbatchaccount.australiaeast.batch.azure.com
POOL_ID=taxodactyl
DEDICATED_NODES=0
NODE_AGENT_SKU="batch.node.ubuntu 24.04"
IMAGE_TAG=canonical:ubuntu-24_04-lts:server
VM_SKU=Standard_L8as_v3
VM_CPUS=8

CACHE_BACKEND=sqlite  # azure_blob for proper caching on Azure, requires the below:
CACHE_AZURE_ACCOUNT_URL=https://<STORAGE_ACCOUNT_STD>.blob.core.windows.net
CACHE_AZURE_CONNECTION_STRING=secret-connection-string
CACHE_AZURE_CONTAINER=cache
CACHE_AZURE_BLOB_PREFIX=taxodactyl/

# Redis (distributed rate-limiting across concurrent workflow instances)
THROTTLE_BACKEND=redis
REDIS_HOST=<vm-name>.<region>.cloudapp.azure.com
REDIS_PORT=6379
REDIS_PASSWORD="your-redis-password"

# Nextflow Azure Configuration
AZURE_BATCH_ACCOUNT_NAME=$BATCH_ACCOUNT
AZURE_BATCH_ENDPOINT=https://$ACCOUNT_ENDPOINT
AZURE_BATCH_ACCESS_KEY="your-batch-account-access-key"
AZURE_STORAGE_ACCOUNT_KEY="your-standard-storage-account-key"
NXF_AZURE_STORAGE_ACCOUNT=$STORAGE_ACCOUNT_STD
NXF_AZURE_REFERENCE_ACCOUNT=$STORAGE_ACCOUNT_PREM
NXF_AZURE_REFERENCE_KEY="your-premium-storage-account-key"

# Workflow Configuration
NCBI_API_KEY="your-ncbi-api-key"
NCBI_USER_EMAIL="your-email@example.com"
ANALYST_NAME="Your Name"
FACILITY_NAME="Your Facility"

# AzCopy SAS Token (optional, for blob storage operations)
AZCOPY_SAS_TOKEN="your-azcopy-sas-token"

# Managed Identity (attached to the Batch pool for Key Vault access)
# See deployment/azure/docs/02-pool-management.md for setup instructions
MANAGED_IDENTITY_NAME=your-managed-identity-name

# Azure Key Vault (for per-user secret storage on Azure Batch)
# See deployment/azure/docs/07-key-vault.md for setup instructions
KEY_VAULT_NAME=your-keyvault-name
AZURE_KEY_VAULT_URL=https://${KEY_VAULT_NAME}.vault.azure.net/
