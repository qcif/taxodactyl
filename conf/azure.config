// Source credentials from .env file before using this:

// export $(grep -v '^#' .env.azure | xargs)
//
// AZURE_BATCH_ACCOUNT_NAME=daffbatch
// AZURE_BATCH_ACCESS_KEY=<primary_key>
// AZURE_BATCH_ENDPOINT=https://daffbatch.australiaeast.batch.azure.com
// AZURE_STORAGE_ACCOUNT_KEY=<key1>

// Azure Blob Storage work directory for all processes
// This is required when using azurebatch executor for any processes
// Local processes (using local/singularity executor) can read/write to Azure Blob Storage
// with minimal overhead for small files (metadata, validation results, etc.)
workDir = 'az://workdata/work'

process {

    // All processes run on Azure Batch executor to maximize single-node utilization
    // Reference data (250GB) is staged ONCE per node at startup via start task
    // Pool autoscales 0-1 nodes, so all tasks run on the same node
    // maxForks controls local concurrency on that single node

    executor = 'azurebatch'
    errorStrategy = 'terminate'  // For development
    queue = 'taxodactyl'
    memory = '2GB'
    container = 'docker.io/library/ubuntu:22.04'
    containerOptions = "-v /mnt/nvme/refdata:/mnt/nvme/refdata:ro -v ${params.temp_root_dir}  --writable-tmpfs"

    // Override containers with docker:// prefix (Azure Batch doesn't accept this scheme)
    withLabel: 'daff_tax_assign' {
        container = 'docker.io/neoformit/taxodactyl:v1.4.3-dev'
    }
    withLabel: 'blast' {
        container = 'docker.io/ncbi/blast:2.16.0'
    }

    // BLAST: Uses full node resources, runs one at a time
    withName: 'BLAST_BLASTN' {
        cpus = 8
        memory = '64GB'
        maxForks = 1
        time = '1h'
        beforeScript = "mkdir -p ${params.temp_root_dir}"
    }

    // MAFFT and FASTME: Use half node resources, can run 2 in parallel
    withName: 'MAFFT_ALIGN|FASTME' {
        cpus = 4
        memory = '32GB'
        maxForks = 2
        time = '1h'
        beforeScript = "mkdir -p ${params.temp_root_dir}"
    }

    // All other processes: Lightweight, queue up to 16 in parallel on single node
    withName = 'EXTRACT_CANDIDATES|EVALUATE_SOURCE_DIVERSITY|EVALUATE_DATABASE_COVERAGE|REPORT' {
        cpus = 1
        memory = '2GB'
        maxForks = 16
        time = '30m'
    }
}

azure {

    //
    // Standard storage for work directory
    // Azure Batch tasks will stage files to/from this storage
    //
    storage {
        accountName = 'daffstandard'
        containerName = 'workdata'
        // Key is automatically taken from: AZURE_STORAGE_ACCOUNT_KEY
    }

    //
    // Premium storage for reference data
    //
    reference {
        accountName = 'daffpremium'
        // Key is automatically taken from: NXF_AZURE_REFERENCE_KEY
    }

    batch {
        location          = 'australiaeast'
        accountName       = 'daffbatch'
        accountKey        = System.getenv('AZURE_BATCH_ACCESS_KEY')
        poolId            = 'taxodactyl'
        autoPoolMode      = false
        allowPoolCreation = false

        // File staging configuration
        // Use 'task' mode to install azcopy in each container
        copyToolInstallMode = 'task'
        deleteTasksOnCompletion = false
        deleteJobsOnCompletion = false

        // Keep nodes warm for 30 minutes after tasks complete
        queueOptions      = '--retain 30m'
    }
}
