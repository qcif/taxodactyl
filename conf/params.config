params {
    //
    // Pipeline specific parameters
    //

    // General input
    metadata = null
    sequences = null
    outdir = 'output'

    // FASTA file constraints (used for validation)
    fasta_max_sequences = 150
    fasta_max_length = 3000
    fasta_min_length = 20

    // Databases
    db_type = 'blast_core_nt'
    blastdb = null
    bold_skip_orientation = 0
    bold_database_name = 'COX1_SPECIES_PUBLIC'
    taxdb = null

    // Extract candidates
    max_candidates_for_analysis = 3
    median_identity_warning_factor = 0.95
    min_identity = 0.935
    min_identity_strict = 0.985
    min_nt = 300
    min_q_coverage = 0.85
    phylogeny_min_hit_identity = 0.935
	phylogeny_min_seqs = 20
	phylogeny_max_seqs = 50
    phylogeny_species_max_seqs = 3
    phylogeny_candidate_max_seqs = 5

    // Database coverage
    allowed_loci_file = "${projectDir}/scripts/config/loci.json"
    db_cov_country_missing_a = 1
    db_cov_min_a = 5
    db_cov_min_b = 1
    db_cov_related_min_a = 90
    db_cov_related_min_b = 10
    db_coverage_max_candidates = 3
    db_coverage_toi_limit = 10
    gbif_accepted_status = 'accepted,doubtful'
    gbif_limit_records = 500
    gbif_max_occurrence_records = 5000

    // Publications supporting taxonomic association
    min_source_count = 5

    // Report
    blast_database_name_for_report = "BLAST Core Nt"
    blast_max_target_seqs_for_report = 2000
    report_debug = 0

    // General
    app_data_dir = "${System.getProperty('user.home')}/.local/share/taxodactyl"
    email = null
    logging_debug = 0
    ncbi_api_key = null
    ncbi_user_email = null
    mock_blast = false
    temp_root_dir = "${launchDir}/taxodactyl_tmp"
    temp_dir_name = null

    //
    // Default nf-core parameters
    //

    // Boilerplate options
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')// Config options
    traceFile                    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true

}