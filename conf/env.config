env {
    
    LOGGING_DEBUG = "${params.logging_debug}"
    BOLD_SKIP_ORIENTATION = "${params.bold_skip_orientation}"

    // Optional: prefer pipeline param, otherwise inherit launcher environment.
    // If absent, downstream code falls back to unauthenticated NCBI requests.
    NCBI_API_KEY = (params.ncbi_api_key ?: System.getenv('NCBI_API_KEY')) ?: ''
    USER_EMAIL = params.ncbi_user_email ?: ''
    TAXONKIT_DATA = params.taxdb ?: ''

}