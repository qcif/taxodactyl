// Variable declarations can't be mixed with config statements (Nextflow 26
// strict syntax), and config values can't reference each other, so each value
// that comes from the Python defaults parses scripts/config/default.yml inline.
process {
    // Internal filename constants (not exposed as user params)
    ext.accessions_filename = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).accessions_filename
    ext.blast_xml_filename = 'blast_result.xml'
    ext.hits_fasta = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).hits_fasta
    ext.hits_json = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).hits_json
    ext.boxplot_img = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).boxplot_img_filename
    ext.candidates_csv = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).candidates_csv
    ext.candidates_fasta = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).candidates_fasta
    ext.candidates_phylogeny_fasta = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).phylogeny_fasta
    ext.candidates_json = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).candidates_json
    ext.candidates_sources_json = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).candidates_sources_json
    ext.independent_sources_json = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).independent_sources_json
    ext.bold_taxonomy_json = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).bold_taxonomy_json
    ext.taxonomy_file = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).taxonomy_file
    ext.candidates_msa = 'candidates_phylogeny.msa'
    ext.tree_nwk = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).tree_nwk_filename
    ext.query_title_file = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).query_title_file
    ext.candidates_count_file = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).candidates_count_file
    ext.taxonomy_id_csv = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).taxonomy_id_csv
    ext.pmi_match_csv = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).pmi_match_csv
    ext.toi_detected_csv = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).toi_detected_csv
    ext.log_filename = new groovy.yaml.YamlSlurper().parse(new File("${projectDir}/scripts/config/default.yml")).log_filename
    ext.versions_yml = 'versions.yml'
    ext.coverage_csv = 'coverage.csv'
}