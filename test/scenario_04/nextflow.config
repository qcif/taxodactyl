params.metadata = "${projectDir}/test/scenario_04/metadata.csv" 
params.blast_xml = "${projectDir}/test/scenario_04/blast_result.xml"
params.mock_blast = true 
params.db_type = "blast_core_nt"
params.blastdb = CUSTOMISE
params.taxdb = CUSTOMISE

singularity {
    cacheDir = CUSTOMISE
}

