nextflow_workflow {

    name "Test Workflow TAXODACTYL"
    script "workflows/taxodactyl.nf"
    workflow "TAXODACTYL"

    test("scenario_02") {

        when {
            workflow {
            }
        }

        then {

            assertAll(
                { assert snapshot(
                    workflow.out.ch_hits_for_report,
                    workflow.out.ch_candidates_for_report,
                    workflow.out.ch_source_diversity_for_report,
                    workflow.out.ch_homology_trees
                ).match() },
                { assert workflow.out.ch_html_report.size() == 77 },
                { assert workflow.out.ch_collated_versions.size() == 1 },
                { assert workflow.out.ch_params_json.size() == 1 },
                { assert workflow.out.ch_workflow_timestamp.size() == 1 },
                { assert workflow.out.ch_db_coverage_maps.size() == 49 },
                { assert workflow.out.ch_db_coverage_maps.collectMany { it[1] instanceof List ? it[1] : [it[1]] }.size() == 60 },
                { assert workflow.out.ch_db_coverage_json.size() == 77 },
                { assert workflow.out.ch_db_coverage_flags.size() == 77 },
                { assert workflow.out.ch_db_coverage_flags.every { it[1].size() == 3 } },
                { assert workflow.out.ch_db_coverage_flags.collectMany { it[1] }.size() == 231 } )
        }
    }
                    
}
