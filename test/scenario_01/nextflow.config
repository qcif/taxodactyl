params.metadata = "${projectDir}/test/scenario_01/metadata.csv" 
params.sequences = "${projectDir}/test/scenario_01/query.fasta" 
params.blast_xml = "${projectDir}/test/scenario_01/blast_result.xml"
params.mock_blast = true 
params.db_type = "blast_core_nt"
params.blastdb = CUSTOMISE
params.taxdb = CUSTOMISE
params.temp_root_dir = CUSTOMISE
params.logging_debug = 1

singularity {
    cacheDir = CUSTOMISE
}

env.NCBI_API_KEY = CUSTOMISE  // Optional: NCBI API credentials for faster execution; get from https://www.ncbi.nlm.nih.gov/account/settings/
env.USER_EMAIL = CUSTOMISE  // Optional: alternative when NCBI API key is unavailable
env.TAXONKIT_DATA = params.taxdb ?: '' // Do not modify